agent {
    data_dir = "/opt/spire/data"
    log_level = "INFO"
    server_address = "spire-server"
    server_port = "8081"
    trust_domain = "governance.demo"
    join_token = "__JOIN_TOKEN__"
    socket_path = "/run/spire/sockets/agent.sock"
    # Real bug found by actually running this: SPIRE refuses to start
    # without either a pre-shared trust_bundle_path/trust_bundle_url or
    # this flag ("trust_bundle_path or trust_bundle_url must be configured
    # unless insecure_bootstrap is set"). There's no out-of-band channel
    # here to pre-share spire-server's self-signed CA with the agent
    # before its first connection, so it trusts the server on that first
    # connection (TOFU) — the same simplicity tradeoff already made by
    # using join_token attestation for this single-machine local demo, not
    # appropriate for a real multi-node production deployment.
    insecure_bootstrap = true
}

plugins {
    NodeAttestor "join_token" {
        plugin_data {}
    }

    KeyManager "memory" {
        plugin_data {}
    }

    # Real bug found by actually running this against Docker Desktop: the
    # "docker" WorkloadAttestor identifies a caller by parsing its cgroup
    # path for a container ID, but Docker Desktop's VM backend produces a
    # cgroup v2 path SPIRE's matcher doesn't recognize (confirmed by
    # reading it directly: "0::/../<container-id>", not the
    # "/docker/<id>"-style path SPIRE expects) — every real connection got
    # "PID attested to have selectors: []", so nothing was ever attested,
    # not a config typo. Switched to the "unix" attestor: it identifies
    # the caller by the real UID/GID the kernel reports on the socket
    # connection (SO_PEERCRED) — no cgroup/Docker-daemon correlation
    # needed, so it isn't sensitive to how a given Docker backend lays out
    # cgroups. The tradeoff: a UID selector alone can't distinguish
    # "the agent container" from "any other container running as the same
    # UID" — but in this topology, the socket itself is only ever mounted
    # into the `agent` service (see docker-compose.yml), so no other
    # container can reach it to begin with; the UID check is real defense
    # in depth on top of that volume-level isolation, not the only gate.
    WorkloadAttestor "unix" {
        plugin_data {}
    }
}
