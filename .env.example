# Copy this file to .env and fill in the two sections below before
# running `docker compose up`. Every other credential this project uses
# (Keycloak admin password, database passwords, Langfuse's NextAuth
# secret/salt, etc.) already has a safe, working default baked into
# docker-compose.yml's `${VAR:-default}` fallbacks — nothing else to set
# here for a local demo. To override one, add it below as VAR=value and
# see the matching `${VAR:-...}` in docker-compose.yml for its name.

# =====================================================================
# REQUIRED — fetched from a real provider, no default exists for these
# =====================================================================

# platform.openai.com -> API keys -> Create new secret key
OPENAI_API_KEY=

# console.groq.com -> API Keys -> Create API Key (free tier, no card needed)
GROQ_API_KEY=

# =====================================================================
# REQUIRED — you generate these yourself, they don't come from anywhere
# =====================================================================
# These two ARE the real API key pair Langfuse's headless-init feature
# (LANGFUSE_INIT_* in docker-compose.yml) uses to create your tracing
# project on first boot — there's no signup form, you just invent the
# values and Langfuse creates a project seeded with exactly what you put
# here. Any random string works; generate one with:
#   openssl rand -hex 16
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
